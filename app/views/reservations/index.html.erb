<h1>自分の予約一覧</h1>

<% if @reservations.any? %>
  <table>
    <thead>
      <tr>
        <th>施設名</th>
        <th>チェックイン</th>
        <th>チェックアウト</th>
        <th>人数</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |res| %>
        <tr>
          <td><%= link_to res.room.name, room_path(res.room) %></td>
          <td><%= res.check_in %></td>
          <td><%= res.check_out %></td>
          <td><%= res.guests %></td>
          <td>
            <%= link_to "編集", edit_reservation_path(res), class: "btn btn-sm btn-primary" %>
            <%= link_to "キャンセル", reservation_path(res), method: :delete, data: { confirm: "本当にキャンセルしますか？" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>予約はまだありません。</p>
<% end %>

<hr>
<%= link_to "施設一覧に戻る", rooms_path, class: "btn btn-secondary" %>