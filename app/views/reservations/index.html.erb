<h1><%= t('reservations.index.title') %></h1>

<% if @reservations.any? %>
  <table>
    <thead>
      <tr>
        <th><%= t('reservations.index.room_name') %></th>
        <th><%= t('reservation.check_in') %></th>
        <th><%= t('reservation.check_out') %></th>
        <th><%= t('reservation.guests') %></th>
        <th><%= t('reservations.index.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |res| %>
        <tr>
          <td><%= link_to res.room.name, room_path(res.room) %></td>
          <td><%= res.check_in %></td>
          <td><%= res.check_out %></td>
          <td><%= res.guests %></td>
          <td>
            <%= link_to t('links.edit'), edit_reservation_path(res), class: "btn btn-sm btn-primary" %>
            <%= link_to t('links.cancel'), reservation_path(res), method: :delete, data: { confirm: t('resetvations.index.cancel_confirm') }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t('reservations.index.no_reservations') %></p>
<% end %>

<hr>
<%= link_to t('links.back_to_rooms'), rooms_path, class: "btn btn-secondary" %>