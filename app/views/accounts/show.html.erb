<h1><%= t('users.show.title') %></h1>

<p>
  <% if current_user.avatar.attached? %>
    <%= image_tag url_for(current_user.avatar), style: "width:28px;height:28px;border-radius:50%;object-fit:cover;" %>
  <% else %>
    <%= image_tag "default-avatar-image.png", alt: "アバター画像", style: "width:28px;height:28px;border-radius:50%;vertical-align:middle;object-fit:cover;" %>
  <% end %>
</p>
<p><strong><%= t('users.show.name') %>:</strong> <%= current_user.name %></p>
<p><strong><%= t('users.show.email') %>:</strong> <%= current_user.email %></p>
<p><strong><%= t('users.show.password') %>:</strong> *********</p>
<p><strong><%= t('users.show.bio') %>:</strong> <%= current_user.bio.presence || "-" %></p>

<p><%= link_to t('users.show.edit_account'), edit_user_registration_path %></p>