<h1>施設一覧</h1>

<%= link_to "新規施設作成", new_room_path %>

<ul>
  <% @rooms.each do |room| %>
    <li>
      <%= link_to room.name, room_path(room) %>
    </li>
  <% end %>
</ul>

<h2>施設を検索</h2>

<%= form_with url: rooms_path, method: :get, local: true do |f| %>
  <p>
    <%= f.label :area, "エリア" %><br>
    <%= f.text_field :area, value: params[:area] %>
  </p>

  <p>
    <%= f.label :keyword, "フリーワード" %><br>
    <%= f.text_field :keyword, value: params[:keyword] %>
  </p>

  <p>
    <%= f.submit "検索", class: "btn btn-primary" %>
  </p>
<% end %>

<%= link_to "自分の予約一覧へ", reservations_path, class: "btn btn-secondary mb-3" %>