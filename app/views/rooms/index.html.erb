<h1><%= t('rooms.index.title') %></h1>

<%= link_to t('rooms.index.new_room'), new_room_path %>

<ul>
  <% @rooms.each do |room| %>
    <li>
      <%= link_to room.name, room_path(room) %>
    </li>
  <% end %>
</ul>

<h2><%= t('rooms.index.search_title') %></h2>

<%= form_with url: rooms_path, method: :get, local: true do |f| %>
  <p>
    <%= f.label :area, t('rooms.index.area') %><br>
    <%= f.text_field :area, value: params[:area] %>
  </p>

  <p>
    <%= f.label :keyword, t('rooms.index.keyword') %><br>
    <%= f.text_field :keyword, value: params[:keyword] %>
  </p>

  <p>
    <%= f.submit t('rooms.index.search_button'), class: "btn btn-primary" %>
  </p>
<% end %>

<%= link_to t('rooms.index.my_reservations'), reservations_path, class: "btn btn-secondary mb-3" %>