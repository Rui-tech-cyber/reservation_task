<h1><%= @room.name %></h1>

<p><strong><%= t('rooms.show.description') %>:</strong> <%= @room.description %></p>
<p><strong><%= t('rooms.show.address') %>:</strong> <%= @room.address %></p>
<p><strong><%= t('rooms.show.price') %>:</strong> <%= number_to_currency(@room.price, unit: "¥") %></p>
<p><strong><%= t('rooms.show.registered_by') %>:</strong> <%= @room.user.email %></p>

<hr>

<%= link_to t('rooms.show.book_now'), new_room_reservation_path(@room), class: "btn btn-primary" %>
<%= link_to t('links.back_to_rooms'), rooms_path, class: "btn btn-secondary" %>

<h2><%= t('rooms.show.reservation_list') %></h2>

<% if @reservations.any? %>
  <table class="table">
    <thead>
      <tr>
        <th><%= t('reservation.check_in') %></th>
        <th><%= t('reservation.check_out') %></th>
        <th><%= t('reservation.guests') %></th>
        <th><%= t('rooms.show.reservation_user') %></th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |reservation| %>
        <tr>
          <td><%= reservation.check_in %></td>
          <td><%= reservation.check_out %></td>
          <td><%= reservation.guests %></td>
          <td><%= reservation.user.email %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t('rooms.show.no_reservations') %></p>
<% end %>

<hr>

<%= link_to t('rooms.show.book_now'), new_room_reservation_path(@room), class: "btn btn-primary" %>
<%= link_to t('links.back_to_rooms'), rooms_path, class: "btn btn-secondary" %>
