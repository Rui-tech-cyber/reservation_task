<h1><%= t('rooms.new.title') %></h1>

<%= form_with model: @room, local: false do |f| %>
  <p>
    <%= f.label :name, t('rooms.form.name') %><br>
    <%= f.text_field :name %>
  </p>

  <p>
    <%= f.label :description, t('rooms.form.description') %><br>
    <%= f.text_area :description %>
  </p>

  <p>
    <%= f.label :price, t('rooms.form.price') %><br>
    <%= f.number_field :price %>
  </p>

  <p>
    <%= f.label :address, t('rooms.form.address') %><br>
    <%= f.text_field :address %>
  </p>

  <p>
    <%= f.submit t('rooms.form.create') %>
  </p>
<% end %>

<%= link_to t('links.back_to_rooms'), rooms_path %>
