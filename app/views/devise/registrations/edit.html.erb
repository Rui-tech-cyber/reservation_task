<h2><%= t('users.edit.title') %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <p>
    <%= f.label :name, t('form.user_name') %><br />
    <%= f.text_field :name, required: true %>
  </p>

  <p>
    <%= f.label :email, t('users.edit.email') %><br />
    <%= f.email_field :email, required: true %>
  </p>

  <p>
    <%= f.label :avatar_filename, t('users.edit.avatar') %><br />
    <%= f.text_field :avatar_filename, placeholder: "example.png（未入力なら既定画像）" %>
  </p>

  <p>
    <%= f.label :bio, t('users.edit.bio') %><br />
    <%= f.text_area :bio %>
  </p>

  <hr>

  <p>
    <%= f.label :password, t('users.edit.password') %> 
    <i>(<%= t('devise.registrations.edit.leave_blank') %>)</i><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </p>

  <p>
    <%= f.label :password_confirmation, t('users.edit.password_confirmation') %><br />
    <%= f.password_field :password_confirmation %>
  </p>

  <p>
    <%= f.label :current_password, t('users.edit.current_password') %><br />
    <%= f.password_field :current_password, required: true %>
  </p>

  <p>
    <%= f.submit t('users.edit.update'), class: "btn btn-primary" %>
  </p>
<% end %>

<%= button_to t('users.edit.cancel_account'), registration_path(resource_name), data: { confirm: t('users.edit.are_you_sure') }, method: :delete, class: "btn btn-danger" %>

<%= link_to t('links.back_to_rooms'), rooms_path, class: "btn btn-secondary" %>